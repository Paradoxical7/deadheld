  m_Script: {fileID: 11500000, guid: dfff4124de14e714fb6065154bc51f0e, type: 3}
  m_Name: Guide_Intro
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSet
  lines:
  - id: 
    speaker: 
    text: "You\u2019re awake... good. Not many come out of cryo anymore."
    yellowText: 
    redText: 
    clip: {fileID: 0}
    yellowClip: {fileID: 0}
    redClip: {fileID: 0}
  - id: 
    speaker: 
    text: "The Main Hub is sealed. I\u2019ve patched my access into its doors - they\u2019ll open for you now."
    yellowText: 
    redText: 
    clip: {fileID: 0}
    yellowClip: {fileID: 0}
    redClip: {fileID: 0}
  - id: 
    speaker: 
    text: Take this map of Zone 1. Press M to look at it.
    yellowText: 
    redText: 
    clip: {fileID: 0}
    yellowClip: {fileID: 0}
    redClip: {fileID: 0}
  - id: 
    speaker: 
    text: And stay out of the dark corners.
    yellowText: 
    redText: 
    clip: {fileID: 0}
    yellowClip: {fileID: 0}
    redClip: {fileID: 0}
  - id: 
    speaker: 
    text: "Check your parasite meter. That\u2019s all the time you\u2019ve got. Don\u2019t let it hit zero - that\u2019s how they get you."
    yellowText: 
    redText: 
    clip: {fileID: 0}
    yellowClip: {fileID: 0}
    redClip: {fileID: 0}
